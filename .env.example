# Copy to .env and adjust. Never commit the real .env.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# anonymous | recognition
VISION_MODE=anonymous

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- PostgreSQL (required) ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://korgoz:CHANGE_ME@localhost:5432/korgoz

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=korgoz_faces
QDRANT_TIMEOUT_SECONDS=5

# --- Camera ---
# Optional camera started by the worker in addition to cameras stored in the DB.
# USB webcam: 0 ; RTSP: rtsp://user:password@192.168.1.10:554/stream1 ; file: data/videos/demo.mp4
CAMERA_ID=1
# CAMERA_URL=0
CAMERA_MAX_FPS=15
CAMERA_LOOP_VIDEO=true
CAMERA_OPEN_TIMEOUT_SECONDS=5
CAMERA_READ_TIMEOUT_SECONDS=5
CAMERA_RECONNECT_INITIAL_DELAY_SECONDS=1
CAMERA_RECONNECT_MAX_DELAY_SECONDS=30
CAMERA_READ_FAILURE_THRESHOLD=10

# --- Vision pipeline ---
# Models are downloaded with: python -m scripts.download_models
DETECTION_INTERVAL=3
PERSON_DETECTOR_ENABLED=true
# yolox_s.onnx (more accurate) or yolox_tiny.onnx (about 3-4x faster on CPU)
PERSON_DETECTOR_MODEL_PATH=models/yolox_s.onnx
PERSON_CONFIDENCE_THRESHOLD=0.5
PERSON_NMS_THRESHOLD=0.45
# 0 = auto (uses every core). Measured in docs/benchmarks.md: 4 for one camera,
# 2 with yolox_tiny for 2-4 cameras on a laptop CPU.
ONNX_NUM_THREADS=0
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_DETECTION_THRESHOLD=0.8

# --- Tracking (ByteTrack) ---
TRACKING_ENABLED=true
TRACK_LOW_THRESHOLD=0.1
TRACK_NEW_THRESHOLD=0.6
TRACK_MATCH_IOU=0.2
# How long a person may be hidden (occlusion) and keep the same track id
TRACK_MAX_LOST_SECONDS=3
TRACK_FLUSH_INTERVAL_SECONDS=5

# --- Recognition (VISION_MODE=recognition only) ---
FACE_EMBEDDING_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
# Cosine similarity 0..1; lower = more matches but more false accepts
FACE_MATCH_THRESHOLD=0.40
FACE_MIN_SIZE=40
FACE_REGISTRATION_MIN_SIZE=80
FACE_MIN_SHARPNESS=30
FACE_MAX_YAW=0.5
RECOGNITION_INTERVAL_SECONDS=1
FACE_UPLOAD_MAX_BYTES=10485760

# --- Events ---
EVENTS_ENABLED=true
EVENT_COOLDOWN_SECONDS=30
UNKNOWN_AFTER_ATTEMPTS=3

# --- Analytics ---
# IANA time zone for hourly charts and peak hours, e.g. Asia/Tashkent, Europe/Moscow
ANALYTICS_TIMEZONE=UTC

# --- Dashboard ---
DASHBOARD_DIR=frontend/dist
# JSON list; only for a dashboard hosted on another origin
# CORS_ORIGINS=["http://localhost:5173"]

# --- Security (see docs/security.md) ---
# First admin: python -m scripts.create_user admin --role admin
AUTH_SESSION_HOURS=12
# true when the API is served over HTTPS (reverse proxy)
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=300
PASSWORD_MIN_LENGTH=10

# --- Live view (worker HTTP server, bind to localhost only; the API proxies it) ---
LIVE_VIEW_ENABLED=true
LIVE_VIEW_HOST=127.0.0.1
LIVE_VIEW_PORT=8001
LIVE_VIEW_JPEG_QUALITY=80
